{
  "name": "roadster-flight-lab",
  "version": "3.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs --open",
    "test": "node scripts/validate.mjs",
    "validate": "node scripts/validate.mjs",
    "compare": "node scripts/compare-models.mjs",
    "package": "python scripts/package-source.py",
    "model:build": "node scripts/model-build.mjs",
    "research": "node scripts/run-study.mjs",
    "test:render": "node tests/render-performance.test.mjs && node tests/local-probe-sun.test.mjs && node qa/exterior-materials-check.mjs && node qa/render-budget-check.mjs",
    "test:hold": "node tests/pose-hold.test.mjs",
    "test:cpu": "node tests/physics-cpu.test.mjs",
    "test:flight": "node tests/flight-controls-3.7.test.mjs && node tests/flight-programs.test.mjs",
    "test:windlab": "node tests/wind-laboratory.test.mjs",
    "test:research-records": "node tests/experiment-records.test.mjs",
    "test:research-road": "node tests/physics-research-3.8.test.mjs && node tests/research-road-3.8.test.mjs",
    "test:visual-structure": "node qa/visual-upgrade-check.mjs",
    "test:timing": "node tests/performance-meter.test.mjs",
    "test:controls": "node tests/physics-controls-3.9.test.mjs && node tests/vehicle-dynamics-3.11.test.mjs && node tests/ui-response-3.11.test.mjs && node tests/braking-corner-3.12.test.mjs && node tests/chase-camera-3.12.test.mjs",
    "test:reproduction": "node tests/reproduction-verdict-3.9.test.mjs",
    "test:corridor": "node tests/visual-corridor-3.9.test.mjs",
    "test:surfaces": "node tests/vehicle-surface-3.10.test.mjs && node tests/inspection-capture-3.10.test.mjs",
    "test:city-lighting": "node tests/city-lighting-3.10.test.mjs",
    "test:control-capture": "node tests/control-capture-3.10.test.mjs && node tests/capture-detail-3.11.test.mjs",
    "test:history": "node tests/history-compatibility-3.10.test.mjs && node tests/history-compatibility-3.11.test.mjs",
    "test:visual-mechanisms": "node tests/visual-regressions-3.11.test.mjs && node tests/reflection-stability-3.12.test.mjs",
    "test:robustness": "node tests/research-robustness-3.11.test.mjs",
    "payloads:restore": "node scripts/repository-payloads.mjs restore",
    "payloads:pack": "node scripts/repository-payloads.mjs pack",
    "test:recovery-grid": "node tests/research-recovery-grid-3.12.test.mjs",
    "test:release": "node scripts/validate-release.mjs"
  }
